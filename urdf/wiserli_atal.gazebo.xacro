<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wiserli_atal_gazebo" params="
    prefix:=''
    include_gripper:=true
    include_camera:=true
    controllers_yaml:='$(find wiserli_atal_description)/config/ros2_controllers.yaml'">

    <!-- Gazebo Harmonic ros2_control plugin -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>

    <!-- High-friction contact properties on Robotiq 2F-85 finger tips for reliable grasping -->
    <xacro:if value="${include_gripper}">
      <gazebo reference="${prefix}robotiq_85_left_finger_tip_link">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>100000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
      </gazebo>

      <gazebo reference="${prefix}robotiq_85_right_finger_tip_link">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>100000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
      </gazebo>
    </xacro:if>

    <!-- Gazebo Harmonic RGB-D Camera Sensor (RealSense D435i specs: 640x480 @ 30 Hz, 69 deg HFOV) -->
    <xacro:if value="${include_camera}">
      <gazebo reference="${prefix}wrist_camera_link">
        <sensor name="${prefix}wrist_rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>wrist_camera</topic>
          <gz_frame_id>${prefix}wrist_camera_optical_frame</gz_frame_id>
          <camera name="${prefix}wrist_rgbd_camera">
            <horizontal_fov>1.2043</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
            <depth_camera>
              <clip>
                <near>0.05</near>
                <far>5.0</far>
              </clip>
            </depth_camera>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
