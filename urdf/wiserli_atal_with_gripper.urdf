      <visual>
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/robotiq_2f_85/visual/left_finger_tip.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/robotiq_2f_85/collision/left_finger_tip.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.01456706 -0.0008 0.01649701" rpy="0 0 0" />
        <mass value="4.268588744e-02" />
        <inertia
          ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06"
          ixy="0.0" ixz="3.5232e-6" iyz="0.0" />
      </inertial>
    </link>

    <link name="robotiq_85_right_finger_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/robotiq_2f_85/visual/right_finger_tip.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/robotiq_2f_85/collision/right_finger_tip.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.01456706 5e-05 0.01649701" rpy="0 0 0" />
        <mass value="4.268588744e-02" />
        <inertia
          ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06"
          ixy="0.0" ixz="-3.5232e-06" iyz="0.0" />
      </inertial>
    </link>

    <!-- Mount gripper base onto parent frame (tool0) -->
    <joint name="robotiq_85_base_joint" type="fixed">
      <parent link="tool0" />
      <child link="robotiq_85_base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Primary actuated joint: 0.0 rad (fully open, 85mm) to 0.8 rad (fully closed, 0mm) -->
    <joint name="robotiq_85_left_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link" />
      <child link="robotiq_85_left_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="0.03060114 0.0 0.05490452" rpy="0 0 0" />
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50.0" />
      <dynamics damping="0.1" friction="0.01" />
    </joint>

    <joint name="robotiq_85_right_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link" />
      <child link="robotiq_85_right_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="-0.03060114 0.0 0.05490452" rpy="0 0 0" />
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50.0" />
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" offset="0" />
      <dynamics damping="0.1" friction="0.01" />
    </joint>

    <joint name="robotiq_85_left_finger_joint" type="fixed">
      <parent link="robotiq_85_left_knuckle_link" />
      <child link="robotiq_85_left_finger_link" />
      <origin xyz="0.03152616 0.0 -0.00376347" rpy="0 0 0" />
    </joint>

    <joint name="robotiq_85_right_finger_joint" type="fixed">
      <parent link="robotiq_85_right_knuckle_link" />
      <child link="robotiq_85_right_finger_link" />
      <origin xyz="-0.03152616 0.0 -0.00376347" rpy="0 0 0" />
    </joint>

    <joint name="robotiq_85_left_inner_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link" />
      <child link="robotiq_85_left_inner_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="0.0127 0.0 0.06142" rpy="0 0 0" />
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50.0" />
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="1" offset="0" />
      <dynamics damping="0.1" friction="0.01" />
    </joint>

    <joint name="robotiq_85_right_inner_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link" />
      <child link="robotiq_85_right_inner_knuckle_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="-0.0127 0.0 0.06142" rpy="0 0 0" />
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50.0" />
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" offset="0" />
      <dynamics damping="0.1" friction="0.01" />
    </joint>

    <joint name="robotiq_85_left_finger_tip_joint" type="revolute">
      <parent link="robotiq_85_left_finger_link" />
      <child link="robotiq_85_left_finger_tip_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="0.00563134 0.0 0.04718515" rpy="0 0 0" />
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50.0" />
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" offset="0" />
      <dynamics damping="0.1" friction="0.01" />
    </joint>

    <joint name="robotiq_85_right_finger_tip_joint" type="revolute">
      <parent link="robotiq_85_right_finger_link" />
      <child link="robotiq_85_right_finger_tip_link" />
      <axis xyz="0 -1 0" />
      <origin xyz="-0.00563134 0.0 0.04718515" rpy="0 0 0" />
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50.0" />
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="1" offset="0" />
      <dynamics damping="0.1" friction="0.01" />
    </joint>

    <!-- Tool Center Point (TCP) centered between the closed/grasp fingertip pads -->
    <link name="gripper_tcp" />
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="robotiq_85_base_link" />
      <child link="gripper_tcp" />
      <origin xyz="0.0 0.0 0.145" rpy="0 0 0" />
    </joint>

    <!-- Wrist-mounted RGB-D Camera (Intel RealSense D435i form factor) on tool0 -->
    <!-- Mounted on +Y side (clear of Robotiq 2F-85 fingers opening along +/-X), tilted 15 deg inward -->
    <link name="wrist_camera_mount_link">
      <inertial>
        <origin xyz="0 0.040 0.015" rpy="0 0 0" />
        <mass value="0.035" />
        <inertia
          ixx="5.0e-06" ixy="0.0" ixz="0.0"
          iyy="8.0e-06" iyz="0.0" izz="1.1e-05" />
      </inertial>
      <visual>
        <origin xyz="0 0.042 0.008" rpy="0 0 0" />
        <geometry>
          <box size="0.044 0.038 0.006" />
        </geometry>
        <material name="camera_bracket_black" />
      </visual>
      <visual>
        <origin xyz="0 0.058 0.018" rpy="0 0 0" />
        <geometry>
          <box size="0.044 0.006 0.020" />
        </geometry>
        <material name="camera_bracket_black" />
      </visual>
      <collision>
        <origin xyz="0 0.044 0.014" rpy="0 0 0" />
        <geometry>
          <box size="0.046 0.040 0.022" />
        </geometry>
      </collision>
    </link>

    <joint name="wrist_camera_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="tool0" />
      <child link="wrist_camera_mount_link" />
    </joint>

    <link name="wrist_camera_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.072" />
        <inertia
          ixx="5.235e-05" ixy="0.0" ixz="0.0"
          iyy="7.5e-06" iyz="0.0" izz="5.235e-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.025 0.090 0.025" />
        </geometry>
        <material name="camera_aluminum" />
      </visual>
      <visual>
        <origin xyz="0.0128 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.002 0.084 0.019" />
        </geometry>
        <material name="camera_glass" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.026 0.092 0.026" />
        </geometry>
      </collision>
    </link>

    <joint name="wrist_camera_joint" type="fixed">
      <origin xyz="0.0 0.058 0.032" rpy="0.0 -1.308997 -1.570796" />
      <parent link="tool0" />
      <child link="wrist_camera_link" />
    </joint>

    <!-- Standard ROS REP-103 Optical Frame (+Z forward, +X right, +Y down) -->
    <link name="wrist_camera_optical_frame" />
    <joint name="wrist_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963" />
      <parent link="wrist_camera_link" />
      <child link="wrist_camera_optical_frame" />
    </joint>

    <!-- Gazebo Harmonic RGB-D Camera Sensor (640x480 @ 30 Hz, 69 deg HFOV) -->
    <gazebo reference="wrist_camera_link">
      <sensor name="wrist_rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>wrist_camera</topic>
        <gz_frame_id>wrist_camera_optical_frame</gz_frame_id>
        <camera name="wrist_rgbd_camera">
          <horizontal_fov>1.2043</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>

</robot>
