<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone ROS 2 URDF for WISERLI-ATAL-C1.1 + Robotiq 2F-85 Gripper.
     For ros2_control and Gazebo Harmonic simulation, use urdf/wiserli_atal.urdf.xacro -->
<robot name="wiserli_atal">
  <material name="wiserli_dark_grey">
    <color rgba="0.23 0.23 0.23 1.0" />
  </material>
  <material name="wiserli_red">
    <color rgba="0.67 0.019608 0.019608 1.0" />
  </material>
  <material name="wiserli_silver">
    <color rgba="0.89412 0.89412 0.89412 1.0" />
  </material>
  <material name="wiserli_actuator_grey">
    <color rgba="0.29 0.31 0.27 1.0" />
  </material>
  <material name="camera_aluminum">
    <color rgba="0.72 0.74 0.76 1.0" />
  </material>
  <material name="camera_glass">
    <color rgba="0.06 0.06 0.08 1.0" />
  </material>
  <material name="camera_bracket_black">
    <color rgba="0.12 0.12 0.14 1.0" />
  </material>

  <link name="world" />


    <!-- Anchor base_link to parent (world by default) -->
    <joint name="base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="world" />
      <child link="base_link" />
    </joint>

    <link name="base_link">
      <inertial>
        <origin xyz="6.2525E-09 -4.9893E-09 0.046727" rpy="0 0 0" />
        <mass value="0.38202" />
        <inertia
          ixx="0.00086555" ixy="0.00016344" ixz="6.6877E-11"
          iyy="0.00056436" iyz="2.546E-11" izz="0.0011619" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/base_link.STL" />
        </geometry>
        <material name="wiserli_dark_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/base_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="link_1">
      <inertial>
        <origin xyz="-0.0013064 0.0089242 0.060012" rpy="0 0 0" />
        <mass value="0.19521" />
        <inertia
          ixx="0.00039384" ixy="-2.0356E-05" ixz="7.1998E-06"
          iyy="0.00052992" iyz="-4.9183E-05" izz="0.00030594" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/link_1.STL" />
        </geometry>
        <material name="wiserli_dark_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://wiserli_atal_description/meshes/link_1.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="joint_1" type="revolute">
      <origin xyz="0 0 0.0625" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="link_1" />
      <axis xyz="0 0 1" />
      <limit lower="-3.14" upper="3.14" effort="60" velocity="20" />
      <dynamics damping="0.5" friction="0.1" />
    </joint>

    <link name="link_2">
      <inertial>
        <origin xyz="0.091706 0.026058 0.11711" rpy="0 0 0" />
        <mass value="0.76071" />
        <inertia
          ixx="0.004311" ixy="-0.00039587" ixz="-0.0031115"
