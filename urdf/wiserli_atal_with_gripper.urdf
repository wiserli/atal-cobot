        <geometry>
          <box size="0.0724 0.0591 0.0728" />
        </geometry>
      </collision>
    </link>
    <joint name="Fixed_6" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="link_5" />
      <child link="Actuator_6" />
    </joint>

