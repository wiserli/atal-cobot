# Track large 3D mesh files with Git LFS (required because meshes/Actuator_4..6.STL exceed GitHub's 100 MB limit)
*.STL filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text

# Enforce consistent LF line endings for code, XML, YAML, and ROS 2 scripts
*.py text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.urdf text eol=lf
*.sdf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.rviz text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.dsv.in text eol=lf
CMakeLists.txt text eol=lf
